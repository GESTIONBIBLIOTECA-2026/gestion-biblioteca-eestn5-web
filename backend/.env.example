# ==========================================================================
# .env.example - Plantilla pública de variables de entorno (SÍ se sube a Git)
# Copiala como backend/.env y completá tus datos:
#     copy backend\.env.example backend\.env      (Windows)
#     cp backend/.env.example backend/.env        (Linux / Mac)
# El .env real NO se sube: está en .gitignore.
# Si falta JWT_SECRET o algún DB_*, el servidor no arranca y avisa cuál falta.
# ==========================================================================

# Puerto del servidor Node/Express (el panel se abre en http://localhost:3001)
PORT=3001

# Clave para firmar los tokens de sesión (inventá un texto largo y secreto)
# Si la app móvil usa la misma clave, los tokens sirven en las dos.
JWT_SECRET=cambiame-por-un-texto-largo-y-secreto

# MySQL en Aiven (Overview → Connection information)
DB_HOST=mysql-biblioteca-eest5-xxxx.aivencloud.com
DB_PORT=27892
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb

# SSL: Aiven lo exige. Guardá el ca.pem de Aiven dentro de backend/
DB_SSL=true
DB_CA_PATH=ca.pem

# Opcionales
# DB_ZONA_HORARIA=-03:00
