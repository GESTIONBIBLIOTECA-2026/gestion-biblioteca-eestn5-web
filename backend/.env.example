# .env.example - Plantilla pública (copiala como .env y completá los datos de Aiven)
# El .env real NO se sube a Git.

# Sesión: inventá un texto largo y secreto (el mismo que use la app en Node, así los tokens sirven en las dos)
JWT_SECRET=

# MySQL en Aiven (Overview → Connection information)
DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb

# SSL: Aiven lo exige. Guardá el ca.pem de Aiven dentro de backend/
DB_SSL=true
DB_CA_PATH=ca.pem

# Hora de Argentina para NOW() y CURRENT_DATE
DB_ZONA_HORARIA=-03:00
